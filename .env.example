# Copy to .env (install.sh does this for you) and fill in. Never commit .env.
# Address of your warroom instance, no trailing slash.
WARROOM_URL=https://warroom.example.com
# Read-only warroom bearer token.
WARROOM_TOKEN=wr_replace_me
# Password for signing in to the planner. 8+ characters, no spaces and none of: # $ " ' \
APP_PASSWORD=replace_me
# Random string used to sign the login cookie. install.sh generates one. Changing it signs everyone out.
SECRET=replace_with_64_random_hex_characters

# Optional
# OSRM_URL=https://router.project-osrm.org   # use your own OSRM server for heavy use
# OSRM_WORKERS=8
